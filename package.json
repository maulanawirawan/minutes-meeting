{
  "name": "narameet-ultimate",
  "version": "2.0.0",
  "description": "AI-Powered Meeting Minutes System with AssemblyAI + LeMUR - 100% FREE!",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "docker:build": "docker build -t narameet-ultimate .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f backend",
    "docker:restart": "docker-compose restart backend",
    "db:migrate": "psql -U narameet -d narameet -f migration.sql",
    "db:reset": "psql -U narameet -d narameet -f migration.sql",
    "setup": "bash setup.sh"
  },
  "keywords": [
    "meeting-minutes",
    "speech-recognition",
    "assemblyai",
    "lemur",
    "ai",
    "transcription",
    "n8n",
    "automation",
    "postgresql",
    "free",
    "ai-summary",
    "speaker-diarization"
  ],
  "author": "naraMeet Team",
  "license": "MIT",
  "dependencies": {
    "assemblyai": "^4.6.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "form-data": "^4.0.4",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.9",
    "pdfkit": "^0.14.0",
    "pg": "^8.11.3",
    "pg-pool": "^3.6.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maulanawirawan/narameet-ultimate"
  },
  "bugs": {
    "url": "https://github.com/maulanawirawan/narameet-ultimate/issues"
  },
  "homepage": "https://github.com/maulanawirawan/narameet-ultimate#readme"
}