# ================================================================
# naraMEET v2.0 ULTIMATE - Environment Variables
# WITH ASSEMBLYAI + LEMUR AI CONFIGURATION
# ================================================================

# ==================== SERVER CONFIGURATION ====================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ==================== JITSI JAAS CONFIG ====================
JITSI_APP_ID=vpaas-magic-cookie-1973ca4a9a4e43d08996769fb612e8f6
JITSI_PRIVATE_KEY_PATH=./ssl-certs/jitsi-private.key
JITSI_KID=vpaas-magic-cookie-1973ca4a9a4e43d08996769fb612e8f6/5e9a6e


# ==================== DATABASE ====================
DATABASE_URL=postgresql://narameet:narameet123@postgres:5432/narameet?sslmode=disable

# For production, use stronger credentials:
# DATABASE_URL=postgresql://narameet_prod:STRONG_PASSWORD_HERE@postgres:5432/narameet_prod

# ==================== REDIS CONFIGURATION ====================
REDIS_URL=redis://redis:6379

# ==================== ASSEMBLYAI CONFIGURATION ====================
# Get your API key from: https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=cc45f2f9ca5f426ba86eb8e4b3009bc8

# Language settings
DEFAULT_LANGUAGE=multi  # Use 'multi' for automatic language detection, 'id' for Indonesian, 'en' for English
ENABLE_SPEAKER_DIARIZATION=true

# ==================== LEMUR AI SETTINGS ====================
# LeMUR Model (Claude Sonnet 4 is recommended)
LEMUR_MODEL=anthropic/claude-sonnet-4-20250514
LEMUR_MAX_TOKENS=4000
LEMUR_TEMPERATURE=0.3
ENABLE_AUTO_SUMMARY=true

# ==================== AUTHENTICATION ====================
# Enable/disable authentication
ENABLE_AUTH=true

# JWT Secret Key - CHANGE THIS IN PRODUCTION!
# Generate with: openssl rand -base64 32
JWT_SECRET=narameet-secret-change-this-in-production-2024

# JWT Expiration
JWT_EXPIRES_IN=7d

# ==================== EMAIL CONFIGURATION ====================
# Set to true to enable email sending
ENABLE_EMAIL=true

# SMTP Configuration (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=awan.maraikoh@gmail.com
SMTP_PASS=junc icbv ryrm rhil

# For Gmail, use App Password: https://myaccount.google.com/apppasswords

# ==================== FILE UPLOAD ====================
# Maximum file size for audio uploads (in bytes)
# Default: 100MB = 104857600 bytes
MAX_FILE_SIZE=104857600

# Upload directory (relative to project root)
UPLOAD_DIR=./uploads

# ==================== LOGGING ====================
# Log level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# Log directory
LOG_DIR=./logs

# ==================== CORS ====================
# Allowed origins for CORS
# Use '*' for development, specific domains for production
CORS_ORIGIN=*

# For production with specific domain:
# CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com

# ==================== RATE LIMITING (OPTIONAL) ====================
# Enable rate limiting to prevent abuse
RATE_LIMIT_ENABLED=false

# Max requests per window
RATE_LIMIT_MAX=100

# Time window in milliseconds (15 minutes)
RATE_LIMIT_WINDOW=900000

# ==================== FEATURE FLAGS ====================
# Enable/disable specific features
FEATURE_AUDIO_RECORDING=true
FEATURE_TRANSCRIPTION=true
FEATURE_AI_SUMMARY=true
FEATURE_SPEAKER_DIARIZATION=true
FEATURE_EXPORT_PDF=true
FEATURE_EXPORT_DOCX=true
FEATURE_EXPORT_CSV=true
FEATURE_EXPORT_JSON=true
FEATURE_EMAIL_SENDING=true
FEATURE_CLOUD_STORAGE=false

# ================================================================
# OPTIONAL: LEGACY SETTINGS (can be removed)
# ================================================================
# If you want to keep backward compatibility with Groq/Whisper:
# GROQ_API_KEY=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
# USE_GROQ=false
# WHISPER_API_URL=http://whisper:9000

# ================================================================
# DEFAULT USER CREDENTIALS
# ================================================================
# Default admin user is created by migration.sql
# Username: admin
# Password: admin123 (bcrypt hashed)
#
# IMPORTANT: Change admin password after first login!

# ================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ================================================================
# [ ] Change JWT_SECRET to a strong random string
# [ ] Change database password
# [ ] Set ENABLE_AUTH=true
# [ ] Configure SMTP for real email sending
# [ ] Set CORS_ORIGIN to your domain
# [ ] Enable HTTPS
# [ ] Set up regular database backups
# [ ] Configure rate limiting
# [ ] Review and restrict file upload sizes
# [ ] Set up monitoring and logging
# [ ] Change default admin password

# ================================================================
# NOTES
# ================================================================
# 1. AssemblyAI API Key is FREE for limited usage
# 2. Get free API key at: https://www.assemblyai.com/dashboard
# 3. Speaker Diarization automatically detects multiple speakers
# 4. LeMUR uses Claude Sonnet 4 for AI summaries
# 5. Supports 100+ languages with multilingual detection
# 6. Email requires valid SMTP credentials
# 7. Never commit .env file to version control
# 8. Add .env to .gitignore